#!/bin/bash
set -euo pipefail

log() {
  echo -e "\033[32m[INFO]\033[0m $1"
}

error() {
  echo -e "\033[31m[ERROR]\033[0m $1" >&2
}

require_ubuntu_24() {
  if [ ! -r /etc/os-release ]; then
    error "Ubuntu 24.04 or newer is required."
    exit 1
  fi
  # shellcheck disable=SC1091
  . /etc/os-release
  local version_major="${VERSION_ID%%.*}"
  if [ "${ID:-}" != "ubuntu" ] || [ "${version_major:-0}" -lt 24 ]; then
    error "Ubuntu 24.04 or newer is required (found ${PRETTY_NAME:-unknown})."
    exit 1
  fi
}

if ! sudo -v; then
  error "This script needs sudo. Run it in a terminal so the password prompt is visible."
  exit 1
fi

require_ubuntu_24

# Ubuntu 24.04+ 的系统源是 deb822：/etc/apt/sources.list.d/ubuntu.sources
replace_mirror_apt() {
  local answer="" sources="/etc/apt/sources.list.d/ubuntu.sources"
  if [ ! -t 0 ]; then
    log "Non-interactive session; keeping the current APT mirror."
    return
  fi
  if [ ! -f "$sources" ]; then
    error "Missing $sources."
    exit 1
  fi

  read -rp "Use USTC mirror for APT? [y/N]: " answer || true
  case $answer in
  [yY]) ;;
  *)
    log "Keeping the current APT mirror."
    return
    ;;
  esac

  if ! grep -qE 'https?://[^[:space:]]+/ubuntu' "$sources"; then
    log "No Ubuntu archive URI matched; $sources was left unchanged."
    return
  fi
  sudo sed -i -E 's#https?://[^[:space:]]+/ubuntu#https://mirrors.ustc.edu.cn/ubuntu#g' "$sources"
  log "Updated Ubuntu mirror in $sources"
}

install_packages_apt() {
  # tealdeer 提供 /usr/bin/tldr。24.04 起用它，不再安装已废弃的 tldr 包。
  # 不安装 python3-pip：PEP 668 下不能往系统 Python 里 pip install。
  local packages=(
    zsh
    tealdeer
    vim
    tmux
    curl
    wget
    openssl
    eza
    build-essential
    python3
    python3-venv
    python3-pygments
    gdb
    zsh-antigen
    direnv
    zip
  )
  log "Installing common components..."
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
  log "Package installation completed."
}

decrypt_files() {
  if [ ! -t 0 ]; then
    log "Non-interactive session; skipping yadm decrypt."
    return
  fi

  local answer=""
  read -rp "Do you want to decrypt encrypted files using yadm? [y/N]: " answer || true
  case $answer in
  [yY])
    yadm decrypt
    log "File decryption completed."
    ;;
  *)
    log "Skipping file decryption."
    ;;
  esac
}

change_login_shell() {
  local zsh_path current_shell
  zsh_path=$(command -v zsh || true)
  if [ -z "$zsh_path" ]; then
    error "zsh is not installed; login shell was not changed."
    return
  fi

  current_shell=$(getent passwd "$USER" | cut -d: -f7)
  if [ "$current_shell" = "$zsh_path" ]; then
    log "Zsh is already the login shell ($zsh_path)."
    return
  fi
  if ! grep -qxF "$zsh_path" /etc/shells; then
    error "$zsh_path is not listed in /etc/shells. Login shell was not changed."
    return
  fi
  if [ ! -t 0 ]; then
    error "chsh needs a terminal. Run: chsh -s $zsh_path"
    return
  fi
  if chsh -s "$zsh_path"; then
    log "Login shell set to $zsh_path. Open a new login session to use it."
  else
    error "Failed to change the login shell."
  fi
}

replace_mirror_apt
sudo DEBIAN_FRONTEND=noninteractive apt-get update
install_packages_apt
decrypt_files
change_login_shell

log "Bootstrap script completed."
